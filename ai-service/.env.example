# Copy file này thành ".env" (cùng thư mục ai-service/) rồi điền giá trị thật.
#
# QUAN TRỌNG: vì AI Service chạy TRONG container Docker, không thể dùng
# "localhost" để trỏ tới Postgres đang chạy trên máy host Windows (localhost
# trong container trỏ vào chính container đó, không phải máy thật của bạn).
# Docker Desktop cung cấp sẵn tên miền đặc biệt "host.docker.internal" để
# container gọi ngược lại máy host — dùng tên này thay cho "localhost".
#
# Lấy đúng USER/PASSWORD/DBNAME giống hệt trong backend/.env, chỉ đổi phần
# "localhost" thành "host.docker.internal".
DATABASE_URL=postgresql://conceptmatch:conceptmatch@host.docker.internal:5432/conceptmatch
