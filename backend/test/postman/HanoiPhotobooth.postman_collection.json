            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"a@example.com\",\n  \"password\": \"Abcd@1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Đăng nhập thành công', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', d.access_token);",
                  "pm.collectionVariables.set('refreshToken', d.refresh_token);"
                ]
              }
            }
          ]
        },
