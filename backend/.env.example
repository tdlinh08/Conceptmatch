# Sao chép thành backend/.env rồi điền giá trị thật. KHÔNG commit file .env.

# Kết nối PostgreSQL (có extension pgvector)
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/conceptmatch

# Khoá ký JWT — đặt chuỗi ngẫu nhiên dài, khác nhau
JWT_ACCESS_SECRET=doi_thanh_chuoi_ngau_nhien_1
JWT_REFRESH_SECRET=doi_thanh_chuoi_ngau_nhien_2

# Đăng nhập Google (Web client ID trên Google Cloud Console)
GOOGLE_CLIENT_ID=

# Dịch vụ AI (FastAPI)
AI_SERVICE_URL=http://localhost:8000

# Gửi email mã quên mật khẩu (Gmail: dùng "Mật khẩu ứng dụng"). Để trống = chỉ in mã ra log.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Mật khẩu chung cho tài khoản chủ studio tạo bởi npm run seed:studios
SEED_OWNER_PASSWORD=

PORT=3000
