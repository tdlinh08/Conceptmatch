generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(uuid())
  full_name     String     @db.VarChar(100)
  email         String     @unique @db.VarChar(255)
  password_hash String?    @db.VarChar(255)
  google_id     String?    @unique @db.VarChar(100)
  avatar_url    String?
  // Lưu bcrypt-hash của refresh token hiện hành (không lưu token gốc).
  // Dùng để: (1) xác thực khi refresh access token, (2) thu hồi khi logout (set về null).
  refresh_token_hash String? @db.VarChar(255)
  role          Role       @default(user)
  status        UserStatus @default(active)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  studios       Studio[]
  bookings      Booking[]
  reviews       Review[]
  conversations Conversation[]
  notifications Notification[]
  messages      Message[]
  audit_logs    AuditLog[]
  view_histories ViewHistory[]
  favorites     Favorite[]


  reports_sent    Report[] @relation("ReportsSent")
  reports_handled Report[] @relation("ReportsHandled")
  @@map("users")
}

model Studio {
  id           String       @id @default(uuid())
  owner_id     String
  name         String       @db.VarChar(150)
  address      String
  district     String       @db.VarChar(50)
  description  String?
  phone        String       @db.VarChar(20)
  // Toạ độ (WGS84) do chủ studio ghim trên bản đồ — không bắt buộc.
  // Dùng cho bản đồ nhỏ + "Chỉ đường" phía khách và sắp xếp "Gần tôi".
  latitude     Float?
  longitude    Float?
  status       StudioStatus @default(pending)
  reject_reason String?
  // Giờ hoạt động riêng của từng studio, dạng "HH:mm" ("24:00" = mở đến nửa đêm).
  open_time    String       @default("08:00") @db.VarChar(5)
  close_time   String       @default("22:00") @db.VarChar(5)
  // Phụ thu (%) cộng thêm vào giá gói — thay cho bảng giá 4 ô (pricing_rules) cũ.
  // Giờ tối: áp dụng khi giờ bắt đầu >= evening_start_time.
  evening_start_time    String @default("18:00") @db.VarChar(5)
  evening_surcharge_pct Int    @default(0)
  weekend_surcharge_pct Int    @default(0)
  // Chữ dùng để tìm kiếm: tên + quận + địa chỉ + tên set + concept, đã BỎ DẤU + chữ thường
  // (src/common/search-text.ts). Cập nhật mỗi khi sửa studio / set.
  search_text  String?
  avg_rating   Float        @default(0)
  review_count Int          @default(0)
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  owner         User           @relation(fields: [owner_id], references: [id])
  sets          StudioSet[]
  images        StudioImage[]
  bookings      Booking[]
  staff         StaffMember[]
  addons        AddonService[]
  reviews       Review[]
  conversations Conversation[]
  view_histories ViewHistory[]
  favorites     Favorite[]

  @@index([owner_id])
  @@index([district])
  @@index([status])
  @@map("studios")
}

model StudioSet {
  id             String   @id @default(uuid())
  studio_id      String
  name           String   @db.VarChar(100)
  description    String?
  style_tag      String?  @db.VarChar(50)
  capacity       Int      @default(2)
  avatar_url     String
  // Vector 512 chiều từ CLIP ViT-B/32, dùng cho AI visual search (pgvector).
  // Prisma không hỗ trợ kiểu vector gốc nên phải khai báo Unsupported.
  // KHÔNG thể query trực tiếp field này qua Prisma Client — phải dùng $queryRaw.
  clip_embedding Unsupported("vector(512)")?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())

  studio   Studio          @relation(fields: [studio_id], references: [id])
  bookings Booking[]
  packages RentalPackage[]
  images   SetImage[]

  @@index([studio_id])
  @@map("studio_sets")
}

// Album ảnh của 1 bối cảnh (set) — khách xem trước khi đặt. Tối đa 10 ảnh/set.
// avatar_url của set vẫn là ảnh đại diện (thẻ set + ảnh để AI tìm kiếm).
model SetImage {
  id         String   @id @default(uuid())
  set_id     String
  url        String
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  set StudioSet @relation(fields: [set_id], references: [id], onDelete: Cascade)

  @@index([set_id])
  @@map("set_images")
}

// Gói thuê của một set (concept). Mỗi set có 1 hoặc nhiều gói: theo giờ, theo buổi, cả ngày...
// Giá = price + max(0, số người - included_people) * extra_person_fee, sau đó cộng phụ thu
// giờ tối / cuối tuần của studio. Công thức nằm ở src/pricing/pricing.ts.
model RentalPackage {
  id               String   @id @default(uuid())
  set_id           String
  name             String   @db.VarChar(100)
  description      String?
  duration_minutes Int
  price            Decimal  @db.Decimal(12, 2)
  included_people  Int      @default(1)
  extra_person_fee Decimal  @default(0) @db.Decimal(12, 2)
  max_people       Int
  // Không xoá gói đã có người đặt (giữ lịch sử) -> ẩn bằng is_active = false
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  set      StudioSet @relation(fields: [set_id], references: [id])
  bookings Booking[]

  @@index([set_id])
  @@map("rental_packages")
}

model StudioImage {
  id         String   @id @default(uuid())
  studio_id  String
  url        String
  is_cover   Boolean  @default(false)
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  studio Studio @relation(fields: [studio_id], references: [id])

  @@index([studio_id])
  @@map("studio_images")
}

// ---------------------------------------------------------------------------
// NHÂN SỰ + DỊCH VỤ THÊM (01/11/2026): thợ ảnh, thợ trang điểm.
// Khách tick dịch vụ thêm khi đặt -> chỉ đặt được khi còn thợ rảnh đúng vai trò;
// chủ studio phân công thợ cụ thể khi xác nhận đơn (không xếp trùng giờ).
// ---------------------------------------------------------------------------

model StaffMember {
  id         String    @id @default(uuid())
  studio_id  String
  full_name  String    @db.VarChar(100)
  role       StaffRole
  phone      String?   @db.VarChar(20)
  avatar_url String?
  // Nghỉ việc / tạm nghỉ -> ẩn, không xoá (còn lịch sử phân công)
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  studio      Studio         @relation(fields: [studio_id], references: [id])
  assignments BookingAddon[]

  @@index([studio_id])
  @@map("staff_members")
}

model AddonService {
  id          String    @id @default(uuid())
  studio_id   String
  role        StaffRole // dịch vụ cần 1 người thuộc vai trò này
  name        String    @db.VarChar(100)
  description String?
  price       Decimal   @db.Decimal(12, 2)
  unit        AddonUnit // tính theo lượt / theo giờ / theo người
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  studio        Studio         @relation(fields: [studio_id], references: [id])
  booking_lines BookingAddon[]

  @@index([studio_id])
  @@map("addon_services")
}

// Dịch vụ thêm trong một đơn (snapshot tên + giá lúc đặt) + thợ được phân công.
model BookingAddon {
  id         String    @id @default(uuid())
  booking_id String
  addon_id   String?
  name       String    @db.VarChar(100)
  role       StaffRole
  unit       AddonUnit
  unit_price Decimal   @db.Decimal(12, 2)
  quantity   Decimal   @db.Decimal(6, 2) // số lượt / số giờ / số người
  amount     Decimal   @db.Decimal(12, 2)
  // Null khi đơn còn "chờ xác nhận"; chủ studio chọn thợ lúc xác nhận
  staff_id   String?

  booking Booking       @relation(fields: [booking_id], references: [id])
  addon   AddonService? @relation(fields: [addon_id], references: [id])
  staff   StaffMember?  @relation(fields: [staff_id], references: [id])

  @@index([booking_id])
  @@index([staff_id])
  @@map("booking_addons")
}

model Booking {
  id             String        @id @default(uuid())
  user_id        String
  studio_id      String
  set_id         String
  // Gói đã đặt. Lưu thêm tên gói tại thời điểm đặt (gói có thể bị sửa/ẩn sau này).
  // Null với các booking tạo trước khi có mô hình gói (bảng giá theo giờ cũ).
  package_id     String?
  package_name   String?       @db.VarChar(100)
  num_people     Int           @default(1)
  start_time     DateTime
  end_time       DateTime
  // Chi tiết giá (snapshot lúc đặt):
  // total_amount = base_amount + extra_people_amount + surcharge_amount + addons_amount
  base_amount         Decimal? @db.Decimal(12, 2)
  extra_people_amount Decimal? @db.Decimal(12, 2)
  surcharge_amount    Decimal? @db.Decimal(12, 2)
  addons_amount       Decimal? @db.Decimal(12, 2)
  total_amount   Decimal       @db.Decimal(12, 2)
  deposit_amount Decimal       @db.Decimal(12, 2)
  status         BookingStatus @default(pending)
  special_note   String?
  cancel_reason  String?
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  user   User      @relation(fields: [user_id], references: [id])
  studio Studio    @relation(fields: [studio_id], references: [id])
  set     StudioSet      @relation(fields: [set_id], references: [id])
  package RentalPackage? @relation(fields: [package_id], references: [id])
  review  Review?
  addons  BookingAddon[]

  @@index([user_id])
  @@index([studio_id])
  // Index phục vụ truy vấn chống double-booking (SELECT FOR UPDATE theo set_id + khoảng thời gian)
  @@index([set_id, start_time, end_time])
  @@map("bookings")
}

model Review {
  id         String   @id @default(uuid())
  booking_id String   @unique
  user_id    String
  studio_id  String
  stars      Int
  comment    String?
  // Admin ẩn đánh giá vi phạm: không hiện công khai, không tính vào điểm trung bình
  is_hidden     Boolean @default(false)
  hidden_reason String?
  created_at DateTime @default(now())

  booking Booking @relation(fields: [booking_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])
  studio  Studio  @relation(fields: [studio_id], references: [id])

  @@index([studio_id])
  @@map("reviews")
}

model Conversation {
  id              String    @id @default(uuid())
  user_id         String
  studio_id       String
  last_message_at DateTime?
  created_at      DateTime  @default(now())

  user     User      @relation(fields: [user_id], references: [id])
  studio   Studio    @relation(fields: [studio_id], references: [id])
  messages Message[]

  @@index([user_id])
  @@index([studio_id])
  @@map("conversations")
}

model Message {
  id              String   @id @default(uuid())
  conversation_id String
  sender_id       String
  content         String
  is_read         Boolean  @default(false)
  sent_at         DateTime @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id])
  sender       User         @relation(fields: [sender_id], references: [id])

  @@index([conversation_id])
  @@map("messages")
}

model Notification {
  id           String           @id @default(uuid())
  recipient_id String
  type         NotificationType
  title        String           @db.VarChar(150)
  body         String
  ref_id       String?
  is_read      Boolean          @default(false)
  created_at   DateTime         @default(now())

  recipient User @relation(fields: [recipient_id], references: [id])

  @@index([recipient_id])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid())
  admin_id    String
  action      String   @db.VarChar(50)
  target_type String   @db.VarChar(50)
  target_id   String
  note        String?
  created_at  DateTime @default(now())

  admin User @relation(fields: [admin_id], references: [id])

  @@index([admin_id])
  @@map("audit_logs")
}

// Bổ sung so với thiết kế CSDL gốc (11 bảng) — tính năng "thêm vào yêu thích"
// từng được nhắc tới ở báo cáo PTTKHT đầu tiên (UC03) nhưng bị rơi mất qua
// các bản SRS/API Contract/DB Design sau, không có bảng nào lưu trạng thái
// này. Bổ sung lại để hoàn thiện đúng ý đồ ban đầu.
model Favorite {
  id         String   @id @default(uuid())
  user_id    String
  studio_id  String
  created_at DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id])
  studio Studio @relation(fields: [studio_id], references: [id])

  @@unique([user_id, studio_id])
  @@index([user_id])
  @@map("favorites")
}

model ViewHistory {
  id        String   @id @default(uuid())
  user_id   String
  studio_id String
  viewed_at DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id])
  studio Studio @relation(fields: [studio_id], references: [id])

  @@index([user_id, viewed_at])
  @@index([studio_id])
  @@map("view_history")
}

enum Role {
  user
  studio_owner
  admin
}

enum UserStatus {
  active
  locked
}

enum StudioStatus {
  pending
  active
  rejected
}

enum StaffRole {
  photographer // thợ ảnh
  makeup       // thợ trang điểm
}

enum AddonUnit {
  per_booking // theo lượt (giá cố định cho cả đơn)
  per_hour    // theo giờ (nhân thời lượng gói)
  per_person  // theo người (nhân số người)
}

enum BookingStatus {
  pending
  confirmed
  checked_in
  completed
  cancelled   // Khách hàng tự huỷ (qua DELETE /bookings/:id)
  rejected    // Studio Owner từ chối (qua PATCH /bookings/:id/status)
  no_show
}

enum NotificationType {
  booking_new
  booking_confirmed
  booking_rejected
  booking_cancelled // khách huỷ -> báo chủ studio (01/11/2026)
  booking_completed // buổi chụp xong -> mời khách đánh giá (01/11/2026)
  review_new
  studio_approved
  studio_rejected
  report_handled // báo cáo vi phạm đã được admin xử lý -> báo người gửi (07/11/2026)
}

enum ReportTargetType {
  studio
  review
}

enum ReportStatus {
  pending // chờ admin xử lý
  resolved // đã xử lý (ẩn đánh giá / gỡ studio)
  dismissed // xem xét và bỏ qua (không vi phạm)
}

// Báo cáo vi phạm do khách / chủ studio gửi (studio sai sự thật, đánh giá xúc phạm...)
model Report {
  id          String           @id @default(uuid())
  reporter_id String
  target_type ReportTargetType
  target_id   String // id studio hoặc id đánh giá
  reason      String           @db.VarChar(100)
  detail      String?
  status      ReportStatus     @default(pending)
  admin_note  String?
  handled_by  String?
  handled_at  DateTime?
  created_at  DateTime         @default(now())

  reporter User  @relation("ReportsSent", fields: [reporter_id], references: [id])
  handler  User? @relation("ReportsHandled", fields: [handled_by], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([target_type, target_id])
  @@map("reports")
}
